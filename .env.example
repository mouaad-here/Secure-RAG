# =============================================================================
# Secure RAG MVP — Environment Configuration
# Copy this file to .env and adjust as needed:  cp .env.example .env
# =============================================================================

# --- LLM (Ollama) ---
OLLAMA_HOST=http://ollama:11434
LLM_MODEL=llama3.2:3b
EMBEDDING_MODEL=nomic-embed-text
LLM_CONTEXT_WINDOW=4096
LLM_TEMPERATURE=0.1

# --- Storage ---
CHROMA_PERSIST_DIR=/app/data/chroma
SQLITE_PATH=/app/data/sqlite/app.db
LOG_DIR=/app/data/logs

# --- Security ---
TRUST_THRESHOLD=0.7
URL_ALLOWLIST=example.com,internal.company.com
# Comma-separated custom sensitive regex patterns or keywords to redact (e.g. credit card, custom PII)
CUSTOM_SENSITIVE_PATTERNS=
# Whether to enable local LLM prompt injection verification during ingestion
ENABLE_AI_SCANNER=false
MAX_CHUNK_SIZE=500
CHUNK_OVERLAP=50

# --- Retrieval ---
RETRIEVAL_TOP_K=5

# --- API ---
API_PORT=8000
LOG_LEVEL=INFO
APP_ENV=development
